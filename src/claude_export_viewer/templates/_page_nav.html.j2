{# Buttons on the right (script: nav.js; Next / Back: msg.js) #}
<nav class="page-nav" id="page-nav" {{ attr("aria-label", "web.nav.label") }} hidden>
  <span class="nav-speed" id="nav-speed" hidden></span>
  <button type="button" data-go="scroll" class="nav-scroll" aria-pressed="false" {{ attr("title", "web.nav.scroll") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="nav-play" d="M8 5l11 7-11 7z"/><path class="nav-pause" d="M8 5v14M16 5v14"/></svg></button>
  {%- if conversation is defined %}
  <button type="button" data-go="back" {{ attr("title", "web.nav.back") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>
  <button type="button" data-go="next" {{ attr("title", "web.nav.next") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
  {%- endif %}
  <button type="button" data-go="top" {{ attr("title", "web.nav.top") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
  <button type="button" data-go="middle" {{ attr("title", "web.nav.middle") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 9h14M5 15h14"/></svg></button>
  <button type="button" data-go="bottom" {{ attr("title", "web.nav.bottom") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg></button>
</nav>
