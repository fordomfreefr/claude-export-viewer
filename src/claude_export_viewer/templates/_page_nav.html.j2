{# Buttons at the bottom right (script: nav.js; Next / Back: msg.js; hide the answers: fold.js), in two
   frames of two columns, read left to right; every button has its own place (style.css), so a missing
   one leaves its place empty, and on a short page the buttons that do nothing are greyed. #}
<nav class="page-nav{% if conversation is defined %} nav-convo{% endif %}" id="page-nav" {{ attr("aria-label", "web.nav.label") }} hidden>
  <span class="nav-speed nav-volume" id="nav-volume" hidden></span>
  <span class="nav-speed" id="nav-speed" hidden></span>
  <div class="nav-group">
  {%- if conversation is defined %}
  <button type="button" data-go="mark" class="nav-keep nav-mark off" aria-disabled="true" {{ attr("title", "web.mark.button") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="th-fill mark-tip" d="M15 4l5 5-8 8H7v-5z"/><path d="M4 20h8"/></svg></button>
  <button type="button" data-go="index" class="nav-keep" data-href="../index.html" {{ attr("title", "web.nav.index") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"/><circle class="th-fill" cx="4.5" cy="6" r="1.4"/><circle class="th-fill" cx="4.5" cy="12" r="1.4"/><circle class="th-fill" cx="4.5" cy="18" r="1.4"/></svg></button>
  {%- endif %}
  <button type="button" data-go="theme" class="nav-keep nav-theme" data-mode="system" {{ attr("title", "web.theme.system") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><g class="th-system"><circle cx="12" cy="12" r="8"/><path class="th-fill" d="M12 4a8 8 0 0 1 0 16z"/></g><g class="th-light"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g><path class="th-dark" d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg></button>
  <button type="button" data-go="music" class="nav-keep nav-music" aria-pressed="false" {{ attr("title", "web.music.play") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 18V5l10-2v13"/><circle class="th-fill" cx="6.5" cy="18" r="2.5"/><circle class="th-fill" cx="16.5" cy="16" r="2.5"/></svg></button>
  {#- 22/11 (Dom): the page before / after in the history of the browser, here rather than after the title (nav.js) #}
  <button type="button" data-go="hist-back" id="hist-back" class="nav-keep" disabled {{ attr("title", "web.hist.back") }}>{{ icon("back", 20) }}</button>
  <button type="button" data-go="hist-forward" id="hist-forward" class="nav-keep" disabled {{ attr("title", "web.hist.forward") }}>{{ icon("forward", 20) }}</button>
  {%- if conversation is defined %}
  <button type="button" data-go="find" class="nav-keep" {{ attr("title", "web.hits.open") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5"/></svg></button>
  <button type="button" data-go="fold" class="nav-keep fold-all" id="fold-all" aria-pressed="false" {{ attr("title", "web.fold.all_hide") }} hidden><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><g class="fold-in"><path d="M2.5 12c1-1.7 4.5-6 9.5-6s8.5 4.3 9.5 6c-1 1.7-4.5 6-9.5 6s-8.5-4.3-9.5-6z"/><circle cx="12" cy="12" r="3"/></g><g class="fold-out"><path d="M3 3l18 18"/><path d="M10.6 6.2A9.8 9.8 0 0 1 12 6c5 0 8.5 4.3 9.5 6a15 15 0 0 1-2.6 3.3M6.5 7.6A15 15 0 0 0 2.5 12c1 1.7 4.5 6 9.5 6a9.6 9.6 0 0 0 4.4-1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></g></svg></button>
  {%- endif %}
  </div>
  <div class="nav-group">
  {%- if conversation is defined %}
  {#- Back | Next (your message before / after: up / down chevrons since 22/11, the arrows ← → looked like the history of the pages): one round button cut in two; under it, reading aloud (speak.js, served only) #}
  <span class="nav-pair"><button type="button" data-go="back" {{ attr("title", "web.nav.back") }}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 14.5l5-5 5 5"/></svg></button><button type="button" data-go="next" {{ attr("title", "web.nav.next") }}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 9.5l5 5 5-5"/></svg></button></span>
  <button type="button" data-go="speak" class="nav-keep nav-speak" aria-pressed="false" {{ attr("title", "web.speak.all") }} hidden>{{ icon("speaker", 20) }}</button>
  {%- endif %}
  <button type="button" data-go="scroll" class="nav-scroll" aria-pressed="false" {{ attr("title", "web.nav.scroll") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="nav-play" d="M7 5l5 5 5-5M7 12l5 5 5-5"/><path class="nav-pause" d="M8 5v14M16 5v14"/></svg></button>
  <button type="button" data-go="top" {{ attr("title", "web.nav.top") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
  <button type="button" data-go="middle" {{ attr("title", "web.nav.middle") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 12h16M12 3v5M9 5.5l3 3 3-3M12 21v-5M9 18.5l3-3 3 3"/></svg></button>
  <button type="button" data-go="bottom" {{ attr("title", "web.nav.bottom") }}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg></button>
  </div>
</nav>
