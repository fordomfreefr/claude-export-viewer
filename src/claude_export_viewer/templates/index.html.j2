{% extends "base.html.j2" %}

{% block content %}
<div class="site-header">
  <span class="site-version">version {{ version }}</span>
  <label class="lang-picker" {{ attr("title", "web.language") }}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg>
    <select id="lang-select" {{ attr("aria-label", "web.language") }}></select>
  </label>
  <h1>{{ T("web.site_title") }}</h1>
</div>
{% if not conversations %}
{#- First launch (P1, 11/11): how to get the export; the button imports through the server (admin.js) #}
<section class="index-section welcome" id="welcome">
  <h2 class="section-title">{{ T("web.welcome.title") }}</h2>
  <div class="dash welcome-body">
    <ol>
      <li>{{ Rich("web.welcome.step1") }}</li>
      <li>{{ Rich("web.welcome.step2") }}</li>
      <li>{{ Rich("web.welcome.step3") }}</li>
    </ol>
    {#- 15/11: a backup found in the downloads (after an uninstall): put back in one click (admin.js) #}
    <p class="restore-found" id="restore-found" hidden><span id="restore-text"></span>
      <button type="button" class="admin-btn" id="restore-go" aria-controls="admin-panel">{{ T("web.restore.button") }}</button></p>
  </div>
</section>
{% endif %}
{% if damaged %}<p class="import-cut">{{ T("web.damaged", files=damaged|join(", ")) }}</p>
{% endif %}{% if import_cut %}<p class="import-cut">{{ T("web.import.interrupted", date=import_cut) }}</p>
{% endif %}
{#- 14/11: "Vue d'ensemble", "Gestion des données" and "Filtres" as tabs, one open at a time (dashboard.js); the data
    one only with the local server (admin.js shows it) #}
<div class="index-tabs" role="tablist">
  {%- if conversations %}<button type="button" class="index-tab" role="tab" id="tab-overview" aria-controls="overview" aria-selected="false">{{ T("web.section.overview") }}</button>{% endif %}
  <button type="button" class="index-tab" role="tab" id="tab-data" aria-controls="admin-bar" aria-selected="false">{{ T("web.section.data") }}</button>
  {%- if conversations %}<button type="button" class="index-tab" role="tab" id="tab-filters" aria-controls="filter-bar" aria-selected="false">{{ T("web.section.filters") }}<span class="tab-n" id="filters-n"></span></button>{% endif %}
</div>
{% if conversations %}
<section class="index-section index-panel" id="overview" role="tabpanel" hidden>
  <div class="dash">
    <div class="dash-line">
      <span class="dash-sum" id="dash-sum"></span><span class="dash-week" id="dash-week"></span>
    </div>
    <div class="dash-body" id="dash-body">
      <div class="dash-tiles" id="dash-tiles" data-size="{{ site_size }}" data-backup="{{ last_backup }}" data-import="{{ last_import }}"></div>
      <div class="dash-chart-head"><span>{{ T("web.dash.chart") }}</span><span class="dash-nav"><button type="button" id="dash-prev" {{ attr("title", "web.dash.prev") }}>&lt;</button><span>{{ T("web.dash.weeks") }}</span><button type="button" id="dash-next" {{ attr("title", "web.dash.next") }}>&gt;</button></span></div>
      <div class="dash-clip"><div class="dash-bars" id="dash-bars"></div></div>
      <div class="dash-axis-clip"><div class="dash-axis" id="dash-axis"></div></div>
    </div>
  </div>
</section>
{% endif %}<section class="index-section index-panel" id="admin-bar" role="tabpanel" hidden>
  {#- 15/11: the tab always shown; without the server (a page opened as a file), this message instead #}
  <p class="admin-noserver" id="admin-noserver" hidden>{{ T("web.data.no_server") }}</p>
  <div class="admin-bar">
  {#- the frame of the import (14/11): a file dropped anywhere on the page, or a click: the latest manifest of the
      downloads, else the window to choose the files (admin.js) #}
  <button type="button" class="drop-zone" id="admin-import" aria-expanded="false" aria-controls="admin-panel" {{ attr("title", "web.import_title") }}>
    <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 15V4M7 9l5-5 5 5"/><path d="M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4"/></svg>
    <span class="drop-text"><span class="drop-main">{{ Rich("web.drop.zone") }}</span>
      {%- if latest_export %}<span class="drop-small">{{ T("web.index.latest_export", date=latest_export) }}</span>{% endif %}
      <span class="drop-small">{{ Rich("web.drop.how_new" if latest_export else "web.drop.how") }}</span></span>
  </button>
  <input type="file" id="admin-files-pick" multiple accept=".json,.zip,application/json,application/zip" hidden>
  <div class="admin-folders" id="admin-folders"{% if not conversations %} hidden{% endif %}>{# nothing to manage yet (15/11) #}
  <div class="admin-row">
    <button type="button" class="admin-btn" id="topics-manage" aria-expanded="false" aria-controls="topics-manager" hidden>{{ T("web.topics.manage") }}</button>
    <button type="button" class="admin-btn" id="admin-backup" aria-controls="admin-panel" {{ attr("title", "web.backup_title") }}>{{ T("web.backup", name=site_name) }}</button>
    <button type="button" class="admin-btn" id="admin-export-all" aria-controls="admin-panel" {{ attr("title", "web.export_all_title") }}>{{ T("web.export_all") }}</button>
    <button type="button" class="admin-btn" id="admin-clean" aria-expanded="false" aria-controls="clean-panel" {{ attr("title", "web.clean.title") }}>{{ T("web.clean.button") }}</button>
    <button type="button" class="admin-btn" id="admin-annot" aria-expanded="false" aria-controls="annot-panel" {{ attr("title", "web.annot_copies.title") }}>{{ T("web.annot_copies.button") }}</button>
    <button type="button" class="admin-btn" id="admin-verify" aria-controls="admin-panel" {{ attr("title", "web.verify.title") }}>{{ T("web.verify.button") }}</button>
    <button type="button" class="admin-btn danger" id="admin-uninstall" aria-expanded="false" aria-controls="uninstall-panel" {{ attr("title", "web.uninstall.title") }}>{{ T("web.uninstall.button") }}</button>
  </div>
  <div class="admin-row admin-downloads" id="admin-downloads" hidden>
    <span>{{ T("web.downloads.label") }}</span>
    <code id="dl-path"></code>
    <button type="button" class="admin-btn small" id="dl-change" aria-expanded="false" aria-controls="dl-form">{{ T("web.downloads.change") }}</button>
    <form class="dl-form" id="dl-form" hidden>
      <input type="text" id="dl-input" spellcheck="false" autocomplete="off" {{ attr("placeholder", "web.downloads.placeholder") }}>
      <button type="submit" class="admin-btn small">{{ T("web.downloads.save") }}</button>
      <button type="button" class="admin-btn small" id="dl-cancel">{{ T("web.downloads.cancel") }}</button>
      <div class="dl-hint">{{ T("web.downloads.hint") }}</div>
      <div class="dl-error" id="dl-error" hidden></div>
    </form>
  </div>
  <div class="admin-row admin-downloads" id="admin-files" hidden>
    <span>{{ T("web.files.label") }}</span>
    <code id="files-path"></code>
    <button type="button" class="admin-btn small" id="files-change" aria-expanded="false" aria-controls="files-form">{{ T("web.downloads.change") }}</button>
    <button type="button" class="admin-btn small" id="files-search" aria-controls="admin-panel" {{ attr("title", "web.files.search_title") }}>{{ T("web.files.search") }}</button>
    <form class="dl-form" id="files-form" hidden>
      <textarea id="files-input" rows="3" spellcheck="false" autocomplete="off"></textarea>
      <button type="submit" class="admin-btn small">{{ T("web.downloads.save") }}</button>
      <button type="button" class="admin-btn small" id="files-cancel">{{ T("web.downloads.cancel") }}</button>
      <div class="dl-hint">{{ T("web.files.hint") }}</div>
      <div class="dl-error" id="files-error" hidden></div>
    </form>
  </div>
  {% if extras and (extras.memory or extras.reflections or extras.design or extras.artifacts or extras.others) %}
  {%- set items = [] %}
  {%- if extras.memory %}{% set _ = items.append(('memory.html', 'web.extras.memory_short', T("web.extras.files", n=extras.memory))) %}{% endif %}
  {%- if extras.reflections %}{% set _ = items.append(('reflections.html', 'web.extras.reflections_short', extras.reflections)) %}{% endif %}
  {%- if extras.design %}{% set _ = items.append(('design.html', 'web.extras.design', extras.design)) %}{% endif %}
  {%- if extras.artifacts %}{% set _ = items.append(('artifacts.html', 'web.extras.artifacts', extras.artifacts)) %}{% endif %}
  <div class="admin-row extras-row" id="extras-row">
    <span>{{ T("web.extras.line") }}</span>
    <span>{% for href, key, n in items %}<a href="extras/{{ href }}">{{ T(key) }}</a>{{ T("web.extras.colon") }}{{ n }}{% if not loop.last or extras.others %} · {% endif %}{% endfor %}
    {%- for o in extras.others %}<a href="extras/other-{{ o.category }}.html">{{ o.label }}</a>{{ T("web.extras.colon") }}{{ T("web.extras.files", n=o.files) }}{% if not loop.last %} · {% endif %}{% endfor %}</span>
  </div>
  {% endif %}
  </div>
  <div class="topics-manager" id="topics-manager" hidden>
    <div class="topics-manager-head">
      <strong>{{ T("web.topics.manage_title") }}</strong>
      <button type="button" class="admin-close" id="topics-close" {{ attr("title", "web.close") }}>{{ icon("cross", 16) }}</button>
    </div>
    <p class="topics-empty" id="topics-empty">{{ T("web.topics.empty") }}</p>
    <ul class="topics-list" id="topics-list"></ul>
    {#- 22/11: a topic is also created here, not only from the menu of a conversation (topics.js) #}
    <form class="topic-new topics-create" id="topics-create">
      <input type="text" maxlength="40" autocomplete="off" spellcheck="false" {{ attr("placeholder", "web.topics.new_placeholder") }}>
      <button type="submit" class="admin-btn small">{{ T("web.topics.create") }}</button>
    </form>
    <div class="dl-error" id="topics-error" hidden></div>
  </div>
  <div class="admin-panel" id="admin-panel" hidden>
    <button type="button" class="admin-close" id="admin-close" {{ attr("title", "web.close") }}>{{ icon("cross", 16) }}</button>
    {#- 15/11: the pages made again during an import, as after an update (Job.progress) #}
    <div class="job-progress" id="job-progress" hidden><div class="job-progress-label" id="job-progress-label"></div>
      <div class="job-track"><div class="job-bar" id="job-progress-bar"></div></div></div>
    <div class="admin-log" id="admin-log"></div>
  </div>
  <div class="clean-panel" id="clean-panel" hidden>
    <div class="clean-head">
      <strong>{{ T("web.clean.head") }}</strong>
      <button type="button" class="admin-close" id="clean-close" {{ attr("title", "web.close") }}>{{ icon("cross", 16) }}</button>
    </div>
    <div class="clean-body" id="clean-body"></div>
  </div>
  {#- AF-f5 (15/11): the states of the annotations kept by CEV, one put back after Oui/Non (admin.js) #}
  <div class="clean-panel annot-panel" id="annot-panel" hidden>
    <div class="clean-head">
      <strong>{{ T("web.annot_copies.head") }}</strong>
      <button type="button" class="admin-close" id="annot-close" {{ attr("title", "web.close") }}>{{ icon("cross", 16) }}</button>
    </div>
    <div class="uninstall-body" id="annot-body"></div>
  </div>
  {#- AF-m1 (14/11): the copies to keep, what will be removed, then Oui/Non (admin.js) #}
  <div class="clean-panel uninstall-panel" id="uninstall-panel" hidden>
    <div class="clean-head">
      <strong>{{ T("web.uninstall.head") }}</strong>
      <button type="button" class="admin-close" id="uninstall-close" {{ attr("title", "web.close") }}>{{ icon("cross", 16) }}</button>
    </div>
    <div class="uninstall-body" id="uninstall-body"></div>
  </div>
  </div>
</section>
<div class="filter-bar index-panel" id="filter-bar" role="tabpanel" hidden>
 <div class="filter-frame">
  <div class="filter-row filter-searches"><div class="search-cell"><input type="search" class="search-box" id="search" {{ attr("placeholder", "web.search") }} autocomplete="off"></div>
  <div class="search-cell"><input type="search" class="search-box content-search" id="content-search" {{ attr2("placeholder", "web.csearch.placeholder", "title", "web.csearch.hint") }} autocomplete="off">
  <div class="content-status" id="content-status" hidden></div></div></div>
  <div class="filter-row filter-controls">
    {% if user_map | length > 1 %}
    <select id="filter-user" class="filter-select">
      <option value="" data-i18n="web.all_users">{{ t("web.all_users") }}</option>
      {% for uuid, name in user_map | dictsort(by='value') %}
      <option value="{{ uuid }}">{{ name }}</option>
      {% endfor %}
    </select>
    {% endif %}
    {% if project_map %}
    <select id="filter-project" class="filter-select">
      <option value="" data-i18n="web.all_projects">{{ t("web.all_projects") }}</option>
      {% for uuid, name in project_map | dictsort(by='value') %}
      <option value="{{ uuid }}">{{ name }}</option>
      {% endfor %}
    </select>
    {% endif %}
    {% if n_deleted %}
    <select id="filter-deleted" class="filter-select">
      <option value="" data-i18n="web.filter.all">{{ t("web.filter.all") }}</option>
      <option value="alive" data-i18n="web.filter.alive">{{ t("web.filter.alive") }}</option>
      <option value="deleted" data-i18n="web.filter.deleted">{{ t("web.filter.deleted") }}</option>
    </select>
    {% endif %}
    <select id="filter-topic" class="filter-select">
      <option value="" data-i18n="web.topics.all">{{ t("web.topics.all") }}</option>
      <option value=" " data-i18n="web.topics.none_filter">{{ t("web.topics.none_filter") }}</option>
    </select>
    <select id="filter-period" class="filter-select" {{ attr("title", "web.period.title") }}>
      {% for value in ("", "7d", "30d", "month", "lastmonth", "year", "lastyear", "custom") %}
      <option value="{{ value }}" data-i18n="web.period.{{ value or 'all' }}">{{ t("web.period." ~ (value or "all")) }}</option>
      {% endfor %}
    </select>
    <div class="period-dates" id="period-dates" hidden>
      <label>{{ T("web.period.from") }} <input type="date" id="period-from"></label>
      <label>{{ T("web.period.to") }} <input type="date" id="period-to"></label>
    </div>
    <select id="sort-by" class="filter-select" {{ attr("title", "web.sort.title") }}>
      {% for value in ("date-desc", "date-asc", "activity-desc", "activity-asc", "name-asc", "name-desc", "messages-desc", "messages-asc") %}
      <option value="{{ value }}" data-i18n="web.sort.{{ value }}">{{ t("web.sort." ~ value) }}</option>
      {% endfor %}
    </select>
  </div>
 </div>
</div>
<div class="result-count" id="result-count" aria-live="polite"></div>
<ul class="conversation-list" id="conversation-list">
  {% for convo in conversations %}
  <li class="conversation-item"
      data-name="{{ (convo.name or t('web.untitled')) | lower }}"
      data-user="{{ convo.account_uuid }}"
      data-project="{{ convo.project_uuid or '' }}"
      data-date="{{ convo.created_at.isoformat() if convo.created_at else '' }}"
      data-activity="{{ convo.last_activity.isoformat() if convo.last_activity else '' }}"
      data-messages="{{ convo.n_messages }}"
      data-tokens="{{ convo.tokens.total if convo.tokens else 0 }}"
      data-deleted="{{ '1' if convo.deleted_since else '' }}"
      data-uuid="{{ convo.uuid }}"
      data-key="{{ convo.filename[:-5] }}">
    <a href="conversations/{{ convo.filename }}">
      <div class="conversation-name">{% if convo.name %}{{ convo.name }}{% else %}{{ T("web.untitled") }}{% endif %}
        {%- if convo.deleted_since %} <span class="deleted-badge" data-i18n="web.deleted_on_claude" {{ attr("title", "web.deleted_badge_title", date=convo.deleted_since) }}{{ args(date=convo.deleted_since) }}>{{ t("web.deleted_on_claude") }}</span>{% endif %}
        {%- if convo.other_versions %} <span class="versions-badge" data-i18n="web.badge.versions" {{ attr("title", "web.badge.versions_title") }}{{ args(n=convo.other_versions) }}>{{ t("web.badge.versions", n=convo.other_versions) }}</span>{% endif %}
        {%- if convo.removed_parts %} <span class="versions-badge" data-i18n="web.badge.removed" {{ attr("title", "web.badge.removed_title") }}{{ args(n=convo.removed_parts) }}>{{ t("web.badge.removed", n=convo.removed_parts) }}</span>{% endif %}
      </div>
      <div class="content-hits" hidden></div>
      <div class="conversation-meta">
        {%- if convo.created_at %}{{ date(convo.created_at) }}{% endif %}
        {%- if convo.active_later %} &middot; {{ T("web.index.last_exchange", date=LocalDate(convo.last_activity)) }}{% endif %}
        &middot; {{ T("web.messages", n=convo.n_messages) }}
        {%- if convo.tokens and convo.tokens.total %} &middot; <span class="tok-count" {{ attr("title", "web.tokens.title", content=Tokens(convo.tokens.content), tools=Tokens(convo.tokens.tools)) }}>{{ T("web.tokens.short", n=Tokens(convo.tokens.total)) }}</span>{% endif %}
        {%- if convo.account_uuid and user_map.get(convo.account_uuid) and user_map | length > 1 %}
        &middot; {{ user_map[convo.account_uuid] }}
        {%- endif %}
        {%- if convo.project_uuid and project_map.get(convo.project_uuid) %}
        &middot; {{ project_map[convo.project_uuid] }}
        {%- endif %}
      </div>
    </a>
    <div class="topic-cell"></div>
  </li>
  {% endfor %}
</ul>

{% include "_page_nav.html.j2" %}
{% endblock %}

{% block scripts %}
<script src="topics-data.js"></script>
<script src="topics.js"></script>
<script src="query.js"></script>
<script src="search.js"></script>
<script>
(function () {
  var search = document.getElementById("search");
  var selects = ["filter-user", "filter-project", "filter-deleted", "filter-topic"].map(function (id) { return document.getElementById(id); });
  var sortSelect = document.getElementById("sort-by");
  var list = document.getElementById("conversation-list");
  var counter = document.getElementById("result-count");
  var items = Array.prototype.slice.call(list.querySelectorAll(".conversation-item"));
  var FILTERS = "cev-index-filtres", SORT = "cev-index-tri";  // remembered by the browser
  var period = document.getElementById("filter-period");
  var periodDates = document.getElementById("period-dates");
  var periodFrom = document.getElementById("period-from"), periodTo = document.getElementById("period-to");

  // The period chosen: [start, end) in ms (local days), null when unbounded.
  // A conversation is kept when it had an exchange in it: created before the end, last
  // exchange after the start.
  function periodRange() {
    var now = new Date(), y = now.getFullYear(), m = now.getMonth(), d = now.getDate();
    function day(s) { var p = s.split("-"); return new Date(+p[0], +p[1] - 1, +p[2]).getTime(); }
    switch (period.value) {
      case "7d": return [new Date(y, m, d - 6).getTime(), null];
      case "30d": return [new Date(y, m, d - 29).getTime(), null];
      case "month": return [new Date(y, m, 1).getTime(), null];
      case "lastmonth": return [new Date(y, m - 1, 1).getTime(), new Date(y, m, 1).getTime()];
      case "year": return [new Date(y, 0, 1).getTime(), null];
      case "lastyear": return [new Date(y - 1, 0, 1).getTime(), new Date(y, 0, 1).getTime()];
      case "custom":
        return [periodFrom.value ? day(periodFrom.value) : null, periodTo.value ? day(periodTo.value) + 864e5 : null];
      default: return [null, null];
    }
  }
  function inPeriod(item, range) {
    if (range[0] === null && range[1] === null) { return true; }
    var created = Date.parse(item.dataset.date || item.dataset.activity);
    var last = Date.parse(item.dataset.activity || item.dataset.date);
    if (isNaN(created) || isNaN(last)) { return false; }  // no date: outside every period
    return (range[1] === null || created < range[1]) && (range[0] === null || last >= range[0]);
  }


  function applyFilters() {
    var q = search.value.trim().toLowerCase();
    var user = selects[0] ? selects[0].value : "";
    var project = selects[1] ? selects[1].value : "";
    var del = selects[2] ? selects[2].value : "";
    var topic = selects[3].value;  // "" every topic, " " without topic
    var shown = 0, range = periodRange();
    periodDates.hidden = period.value !== "custom";
    items.forEach(function (item) {
      var ok = (!q || item.dataset.name.indexOf(q) >= 0)
        && (!user || item.dataset.user === user)
        && (!project || item.dataset.project === project)
        && (!del || (del === "deleted") === (item.dataset.deleted === "1"))
        && (!topic || (item.dataset.topic || " ") === topic)
        && inPeriod(item, range)
        && CEVContent.ok(item);
      item.style.display = ok ? "" : "none";
      if (ok) { shown++; }
    });
    // the number of filters set, beside the name of the tab "Filtres" (14/11): seen even when the tab is closed
    var set = (q ? 1 : 0) + (document.getElementById("content-search").value.trim() ? 1 : 0) + (period.value ? 1 : 0) +
      selects.filter(function (el) { return el && el.value; }).length;
    var tabN = document.getElementById("filters-n");
    if (tabN) { tabN.textContent = set ? " (" + set + ")" : ""; }
    counter.textContent = shown === items.length ? CEV.t("web.index.count", { n: items.length })
      : (shown === 0 ? CEV.t("web.index.none_of", { n: items.length })
        : CEV.t("web.index.shown_of", { shown: shown, n: items.length }));
    try {
      sessionStorage.setItem(FILTERS, JSON.stringify({ q: search.value, s: selects.map(function (el) { return el ? el.value : ""; }),
        p: [period.value, periodFrom.value, periodTo.value] }));
    } catch (e) { /* storage unavailable */ }
  }

  function by(key, dir) {
    return function (a, b) { return dir * (a.dataset[key] || "").localeCompare(b.dataset[key] || ""); };
  }
  var SORTS = {
    "date-desc": by("date", -1), "date-asc": by("date", 1),
    "activity-desc": by("activity", -1), "activity-asc": by("activity", 1),
    "name-asc": function (a, b) { return a.dataset.name.localeCompare(b.dataset.name, CEV.lang()); },
    "name-desc": function (a, b) { return b.dataset.name.localeCompare(a.dataset.name, CEV.lang()); },
    "messages-desc": function (a, b) { return (+b.dataset.messages) - (+a.dataset.messages); },
    "messages-asc": function (a, b) { return (+a.dataset.messages) - (+b.dataset.messages); }
  };

  function applySort() {
    var cmp = SORTS[sortSelect.value] || SORTS["date-desc"];
    items.slice().sort(cmp).forEach(function (item) { list.appendChild(item); });
    try { localStorage.setItem(SORT, sortSelect.value); } catch (e) { /* storage unavailable */ }
  }

  CEVTopics.init(items);  // topic of each conversation, menus and filter options
  // restore the last search, filters and order
  try {
    var saved = JSON.parse(sessionStorage.getItem(FILTERS) || "null");
    if (saved) {
      search.value = saved.q || "";
      selects.forEach(function (el, i) {
        var value = saved.s ? saved.s[i] : undefined;
        if (el && Array.prototype.some.call(el.options, function (o) { return o.value === value; })) { el.value = value; }
      });
      if (saved.p) { period.value = saved.p[0] || ""; periodFrom.value = saved.p[1] || ""; periodTo.value = saved.p[2] || ""; }
    }
    var sort = localStorage.getItem(SORT);
    if (sort && SORTS[sort]) { sortSelect.value = sort; }
  } catch (e) { /* storage unavailable: defaults */ }

  search.addEventListener("input", applyFilters);
  selects.forEach(function (el) { if (el) { el.addEventListener("change", applyFilters); } });
  sortSelect.addEventListener("change", applySort);
  [period, periodFrom, periodTo].forEach(function (el) { el.addEventListener("change", applyFilters); });
  document.addEventListener("cev-language", applyFilters);  // the counter follows the language
  document.addEventListener("cev-topics", applyFilters);  // a topic changed
  document.addEventListener("cev-content", applyFilters);  // search in the content (search.js)
  if (sortSelect.value !== "date-desc") { applySort(); }
  applyFilters();
})();
</script>
